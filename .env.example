# Copy this file to `.env` and fill in your keys. NEVER commit the real .env.

# --- LLM (only needed if you switch off the local Ollama llama3 model) ---
OPENAI_API_KEY=

# --- Tavily web search (Trend Strategist tool) ---
TAVILY_API_KEY=

# --- LangSmith observability / tracing ---
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=social-media-copilot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
